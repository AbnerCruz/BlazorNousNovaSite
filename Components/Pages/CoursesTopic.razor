@page "/courses/{DisciplineLabel}/{CourseId}/{ModuleId}/{ChapterId}/{TopicId}"
@rendermode InteractiveServer
@using SchoolData
@inject IJSRuntime JS
@inject NavigationManager NavManager

<PageTitle>@(topic?.Name ?? "Conteúdo") | Nous Nova</PageTitle>

<div style="max-width: 90%; margin: 0 auto; padding: 1rem 2rem; box-shadow:var(--shadow-2)">
    @if (topic != null && module != null && course != null && discipline != null)
    {
        <article>
            <nav>
                <div>
                    <a href="/disciplines/@DisciplineLabel">@discipline.Name</a>
                    <span>&rsaquo;</span>
                    <a href="/courses/@DisciplineLabel/@CourseId">@course.Name</a>
                    <span>&rsaquo;</span>
                    <a href="/courses/@DisciplineLabel/@CourseId/@ModuleId">@module.Name</a>
                    <span>&rsaquo;</span>
                    <span>@topic.Name</span>
                </div>
                <hr/>
            </nav>

            <div style="padding:2rem 5rem;">
                @((MarkupString)topic.Body)
            </div>
        </article>

        <div class="grid" style="width:100%">
            <div>
                @if (!string.IsNullOrEmpty(prevTopicUrl))
                {
                    <ButtonComponent Href="@prevTopicUrl" Text="Anterior" Width="100%" />
                }
            </div>
            <div>
                @if (!string.IsNullOrEmpty(nextTopicUrl))
                {
                    <ButtonComponent Href="@nextTopicUrl" Text="Próxima Seção" Width="100%" />
                }
                else
                {
                    <ButtonComponent Href=@($"/courses/{DisciplineLabel}/{CourseId}/{ModuleId}") Text="Concluir Módulo" Color="bggreen-2" Width="100%" />
                }
            </div>
        </div>
    }
    else
    {
        <div>
            <p>Tópico não encontrado.</p>
        </div>
    }
</div>

@code {
    [Parameter] public string DisciplineLabel { get; set; } = string.Empty;
    [Parameter] public string CourseId { get; set; } = string.Empty;
    [Parameter] public string ModuleId { get; set; } = string.Empty;
    [Parameter] public string ChapterId { get; set; } = string.Empty;
    [Parameter] public string TopicId { get; set; } = string.Empty;

    DisciplinesData disciplineData = new DisciplinesData();
    
    // Variáveis de Dados
    Discipline? discipline;
    Course? course;
    Module? module;
    Chapter? chapter;
    Topic? topic;

    // Variáveis de Navegação
    string nextTopicUrl = "";
    string prevTopicUrl = "";

    protected override void OnInitialized()
    {
        // 1. Carrega toda a hierarquia de dados
        discipline = disciplineData.Disciplines.FirstOrDefault(d => d.Label.Equals(DisciplineLabel, StringComparison.InvariantCultureIgnoreCase));
        if (discipline == null) return;

        course = discipline.Courses.FirstOrDefault(c => c.Id.Equals(CourseId, StringComparison.InvariantCultureIgnoreCase));
        if (course == null || course.Curriculum == null) return;

        module = course.Curriculum.FirstOrDefault(m => m.Id.Equals(ModuleId, StringComparison.InvariantCultureIgnoreCase));
        if (module == null) return;

        chapter = module.Chapters.FirstOrDefault(c => c.Id.Equals(ChapterId, StringComparison.InvariantCultureIgnoreCase));
        if (chapter == null) return;

        topic = chapter.Topics.FirstOrDefault(t => t.Id.Equals(TopicId, StringComparison.InvariantCultureIgnoreCase));
        
        // 2. Se achou o tópico, calcula os links de navegação
        if (topic != null)
        {
            CalculateNavigation();
        }
    }

    private void CalculateNavigation()
    {
        if (module == null || chapter == null || topic == null) return;

        int currentChapterIndex = module.Chapters.IndexOf(chapter);
        int currentTopicIndex = chapter.Topics.IndexOf(topic);

        // --- Lógica do ANTERIOR ---
        if (currentTopicIndex > 0)
        {
            // Mesmo capítulo, tópico anterior
            var prevTopic = chapter.Topics[currentTopicIndex - 1];
            prevTopicUrl = BuildUrl(chapter.Id, prevTopic.Id);
        }
        else if (currentChapterIndex > 0)
        {
            // Capítulo anterior, último tópico dele
            var prevChapter = module.Chapters[currentChapterIndex - 1];
            if (prevChapter.Topics.Any())
            {
                var lastTopicOfPrevChapter = prevChapter.Topics.Last();
                prevTopicUrl = BuildUrl(prevChapter.Id, lastTopicOfPrevChapter.Id);
            }
        }

        // --- Lógica do PRÓXIMO ---
        if (currentTopicIndex < chapter.Topics.Count - 1)
        {
            // Mesmo capítulo, próximo tópico
            var nextTopic = chapter.Topics[currentTopicIndex + 1];
            nextTopicUrl = BuildUrl(chapter.Id, nextTopic.Id);
        }
        else if (currentChapterIndex < module.Chapters.Count - 1)
        {
            // Próximo capítulo, primeiro tópico dele
            var nextChapter = module.Chapters[currentChapterIndex + 1];
            if (nextChapter.Topics.Any())
            {
                var firstTopicOfNextChapter = nextChapter.Topics.First();
                nextTopicUrl = BuildUrl(nextChapter.Id, firstTopicOfNextChapter.Id);
            }
        }
    }

    // Helper para montar a string da URL
    private string BuildUrl(string targetChapterId, string targetTopicId)
    {
        return $"/courses/{DisciplineLabel}/{CourseId}/{ModuleId}/{targetChapterId}/{targetTopicId}";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try { await JS.InvokeVoidAsync("renderMath"); } catch { }
        if (firstRender) { await JS.InvokeVoidAsync("scrollToTop"); }
    }
}