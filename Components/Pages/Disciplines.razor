@page "/disciplines/{DisciplineLabel}"
@using SchoolData
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer


<PageTitle>@discipline?.Name</PageTitle>

<div class="discipline-page">
    @if (discipline != null)
    {
        <section>
            <CtaComponent Title="Garanta seu acesso!" Subtitle="@($"Escolha o plano ideal e domine {discipline?.Name}")"
                ButtonText="Ver Planos" ButtonHref="/subscription" ButtonColor="bggreen-2"
                ImageUrl="images/SubscriptionsCtaImage.png" />
        </section>
        @foreach (var content in discipline.Sections ?? new Dictionary<string, object>())
        {
            <section>
                <h1>@content.Key</h1>

                @if (content.Value is string text)
                {
                    <p>@text</p>
                }
                else if (content.Value is List<Course> courses)
                {
                    <div class="grid">
                        @foreach (Course course in courses)
                        {
                            <div class="card">
                                <h2 class="card-title">@course.Name</h2>
                                @foreach (Content curriculum in course.Curriculum)
                                {
                                    <div class="curriculum-section">
                                        <h3 class="colgold-1">@curriculum.Name</h3>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </section>
        }
        <section>
            <CtaComponent Title="Garanta Sua Vaga!" Subtitle=@($"Estude {@discipline.Name} e desenvolva a            capacidade de argumentar, escrever e transmitir conhecimento. Como quem busca o topo das classificações em            olimpíadas e vestibulares.") ButtonText="Matrícula" ButtonHref="/registration" ButtonColor="bggreen-2"
                ImageUrl="images/RegistrationCtaImage.png"/>
        </section>

    }
    else
    {
        <p>Discipline not found.</p>
    }
</div>

@code {
    [Parameter]
    public string DisciplineLabel { get; set; } = string.Empty;

    DisciplinesData disciplineData = new DisciplinesData();
    Discipline? discipline;

    protected override void OnInitialized()
    {
        discipline = disciplineData.Disciplines.FirstOrDefault(d => d.Label == DisciplineLabel);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("renderMath");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao renderizar MathJax: {ex.Message}");
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        discipline = disciplineData.Disciplines.FirstOrDefault(d => d.Label == DisciplineLabel);
        await base.OnParametersSetAsync();
    }
}